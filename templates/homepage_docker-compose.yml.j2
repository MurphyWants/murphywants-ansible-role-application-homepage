version: "3.3"
services:
  homepage:
    image: ghcr.io/gethomepage/homepage:{{ HOMEPAGE_CONTAINER_VERSION }}
    container_name: homepage
    ports:
      - "127.0.0.1:{{ HOMEPAGE_HTTP_PORT }}:3000"
    volumes:
      - {{ HOMEPAGE_PATH }}/volumes/homepage-app-config:/app/config
      - {{ HOMEPAGE_PATH }}/volumes/homepage-app-public-icons:/app/public/icons
    environment:
      - PUID={{ HOMEPAGE_PUID }}
      - PGID={{ HOMEPAGE_PGID }}
      - COMPOSE_PROJECT_NAME=homepage
      - HOMEPAGE_ALLOWED_HOSTS={{ HOMEPAGE_FQDN }}
    restart: unless-stopped